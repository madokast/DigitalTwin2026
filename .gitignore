# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Aliyun FC local secrets + Serverless Devs build output
faas/providers/aliyun-fc/.env.fc.*
faas/providers/aliyun-fc/.s-build/
faas/providers/aliyun-fc/.s/
faas/providers/aliyun-fc/.env.fc.test
faas/providers/aliyun-fc/.env.fc.prod

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OpenAPI Redoc preview (npm run openapi:preview)
openapi/redoc-static.html
