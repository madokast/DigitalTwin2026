# 复制为 .env.fc.test 或 .env.fc.prod（已被 gitignore）
# test → 测试库；prod → 与 Vercel 相同的生产 DATABASE_URL
DATABASE_URL=
DIGITAL_TWIN_TOKEN=
DIGITAL_TWIN_ADMIN_TOKEN=
# Telegram 录入通知（可选；两者皆非空才启用；deploy 会问 Enable?）
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# QQ Bot 录入通知（可选；三键皆非空才启用；deploy 会问 Enable?）
QQBOT_APP_ID=
QQBOT_APP_SECRET=
QQBOT_USER_OPENID=

# 测试环境默认跳过 notify_user；设为 1 才允许在 DIGITAL_TWIN_TEST=1 时发送
# NOTIFY_ALLOW_IN_TEST=
