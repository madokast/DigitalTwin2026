# 复制为 .env.test：cp .env.test.example .env.test
#
# 本地开发 / Next / drizzle / vitest / `npm run deploy -- test` 共用本文件。
# API 集成测（TRUNCATE）使用 DATABASE_URL；hostname 或库名须含 test / TestDigitalTwin，否则 Skip / 拒绝。
# 双端一键：`npm run test:integration`（Node tests/api + Go httpx/dbprobe；缺/不安全则 fail-fast）。
# 生产密钥由 `npm run deploy -- prod` → collect-prod-env 写入临时 .env.prod（exit 删除），勿写进本文件。
#
# 顶层部署：
#   npm run deploy -- test   # 跳过 Vercel；可选 FC/SCF（读本文件）
#   npm run deploy -- prod   # 收集密钥 → Vercel 必做；可选 FC/SCF

# 日常开发 / db:migrate / 本地 next / API 集成测共用。
# 集成测：缺失则 Skip；已设但 host/库名不含 test 则拒绝（不 wipe）。
DATABASE_URL=

# API Bearer Token（AI / 查询 / 录入；自动化测试也会读取）
DIGITAL_TWIN_TOKEN=

# Admin Bearer Token（仅 /api/admin/*；只给网页，禁止交给 AI）
DIGITAL_TWIN_ADMIN_TOKEN=

# Telegram 录入通知（可选；两者皆非空才启用）
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# QQ Bot 录入通知（可选；三键皆非空才启用；与 Telegram 并行经 notify_user）
QQBOT_APP_ID=
QQBOT_APP_SECRET=
# 监听拿到的私聊 user_openid（可选手写；历史消息不会回放，需先跑 listen 再私聊机器人）
QQBOT_USER_OPENID=
# 可选：监听超时毫秒，默认 120000
# QQBOT_LISTEN_TIMEOUT_MS=120000

# FaaS 函数名（deploy test / prod 写入云侧；IaC 占位会被覆盖）
FC_FUNCTION_NAME=digitaltwin-api-test
SCF_FUNCTION_NAME=digitaltwin-api-test

# 测试环境默认跳过 notify_user；设为 1 才允许在 DIGITAL_TWIN_TEST=1 时发送
# NOTIFY_ALLOW_IN_TEST=
