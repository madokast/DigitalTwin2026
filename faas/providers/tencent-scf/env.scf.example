# 复制为 .env.scf.test 或 .env.scf.prod（已被 gitignore）
# test → 测试库；prod → 与 Vercel 相同的生产 DATABASE_URL
# DATABASE_URL 含 & 等字符时必须单引号包裹，供 scf_bootstrap `source`：
# DATABASE_URL='postgresql://user:pass@host/db?sslmode=require&channel_binding=require'
# 空库须先：DATABASE_URL=… npm run db:migrate（否则 /api/query 鉴权后 500）
DATABASE_URL=
DIGITAL_TWIN_TOKEN=
DIGITAL_TWIN_ADMIN_TOKEN=

# Telegram 录入通知（可选；两者皆非空才启用）
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# QQ Bot 录入通知（可选；三键皆非空才启用）
QQBOT_APP_ID=
QQBOT_APP_SECRET=
QQBOT_USER_OPENID=

# 测试环境默认跳过 notify_user；设为 1 才允许在 DIGITAL_TWIN_TEST=1 时发送
# NOTIFY_ALLOW_IN_TEST=

# Serverless Cloud Framework 可选：强制腾讯云厂商（境外环境见官方 FAQ）
# SERVERLESS_PLATFORM_VENDOR=tencent
