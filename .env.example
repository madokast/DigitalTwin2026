# 复制为 .env 后填入真实值：cp .env.example .env
#
# 本地开发可用 DATABASE_URL；API 集成测（TRUNCATE）只认 TEST_DATABASE_URL。
# 二者可指向同一专用测试 Neon，但 hostname 或库名须含 test / TestDigitalTwin。
# 生产库连接串只配在 Vercel / FC prod，不要写进本地 .env，更不要填进 TEST_DATABASE_URL。
#
# 刷新生产三件套（交互 → Vercel production + 临时 .env.fc.prod 部署 FC prod → 删除该文件）：
#   npm run secrets:refresh-prod
# 详见 faas/providers/aliyun-fc/README.md「生产密钥刷新」。

# 日常开发 / db:migrate / 本地 next 用（勿对生产库跑 destructive 操作）
DATABASE_URL=

# 仅 API 集成测（vitest tests/api）：migrate + 用例间 TRUNCATE，不再 DROP schema。
# 缺失则 Skip。可与 DATABASE_URL 同串；须为专用测试库（host/库名含 test 或 TestDigitalTwin）。
TEST_DATABASE_URL=

# API Bearer Token（AI / 查询 / 录入；自动化测试也会读取）
DIGITAL_TWIN_TOKEN=

# Admin Bearer Token（仅 /api/admin/*；只给网页，禁止交给 AI）
DIGITAL_TWIN_ADMIN_TOKEN=

# Telegram 录入通知（可选；两者皆非空才启用；test/prod 可共用同一套）
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# QQ Bot 录入通知（可选；三键皆非空才启用；与 Telegram 并行经 notify_user）
QQBOT_APP_ID=
QQBOT_APP_SECRET=
# 监听拿到的私聊 user_openid（可选手写；历史消息不会回放，需先跑 listen 再私聊机器人）
QQBOT_USER_OPENID=
# 可选：监听超时毫秒，默认 120000
# QQBOT_LISTEN_TIMEOUT_MS=120000

# 测试环境默认跳过 notify_user；设为 1 才允许在 DIGITAL_TWIN_TEST=1 时发送
# NOTIFY_ALLOW_IN_TEST=
