# 复制为 .env 后填入真实值：cp .env.example .env
#
# 个人小项目约定：本地只用一份 .env，不拆 .env.test / DATABASE_URL_TEST。
# 本地 DATABASE_URL 指向「专用于测试」的 Neon PostgreSQL。
# 生产库连接串只配在 Vercel / FC prod，不要写进本地 .env。
#
# 刷新生产三件套（交互 → Vercel production + 临时 .env.fc.prod 部署 FC prod → 删除该文件）：
#   npm run secrets:refresh-prod
# 详见 fc/README.md「生产密钥刷新」。

# 测试库连接串（本地开发 / db:migrate / 自动化测试必填；勿对生产库跑 npm test）
DATABASE_URL=

# API Bearer Token（AI / 查询 / 录入；自动化测试也会读取）
DIGITAL_TWIN_TOKEN=

# Admin Bearer Token（仅 /api/admin/*；只给网页，禁止交给 AI）
DIGITAL_TWIN_ADMIN_TOKEN=
